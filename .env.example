# Copy to .env.local. Never commit .env.local.

# Postgres — local (docker compose / Homebrew) …
DATABASE_URL=postgres://mira:mira@localhost:5433/mira
# … or Supabase: Project → Connect → "Transaction pooler" string, port 6543. TLS and pool size are set automatically.
# DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# LLM — Google AI Studio key with billing enabled on the project
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=<your key>
MIRA_MODEL=gemini-3.6-flash
# Any OpenAI-compatible endpoint works with the same three variables.

# Auth — Clerk (dashboard.clerk.com → your app → API keys). Every page and API route requires a session.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# /review and /trace additionally require publicMetadata {"reviewer": true} on the user (Clerk dashboard → Users → Metadata).

# Supabase project (Settings → API). Only used by the browser to read the signed-in user's own history through
# RLS with the Clerk session token — requires Clerk registered as a third-party auth provider (see README → Auth).
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
