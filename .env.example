# Copy to .env.local. Never commit .env.local.
# Local (docker compose / Homebrew):
DATABASE_URL=postgres://mira:mira@localhost:5433/mira
# Hosted (Supabase): Project → Connect → "Transaction pooler" string, port 6543. TLS and pool size are set automatically.
# DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Default: Ollama, local and free (brew install ollama && ollama pull llama3.1:8b)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
MIRA_MODEL=llama3.1:8b

# Hosted alternative: Google AI Studio key with billing enabled (free tier is too small for the eval)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=<your key>
# MIRA_MODEL=gemini-3.6-flash
