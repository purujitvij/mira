# Copy to .env.local. Never commit .env.local.
DATABASE_URL=postgres://mira:mira@localhost:5433/mira

# Default: Ollama, local and free (brew install ollama && ollama pull llama3.1:8b)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
MIRA_MODEL=llama3.1:8b

# Any OpenAI-compatible provider works instead, e.g. Gemini:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=AIza...
# MIRA_MODEL=gemini-2.5-flash
